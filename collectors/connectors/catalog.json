{
  "mysql": {
    "name": "MySQL / MariaDB",
    "endpoint": "/run/mysqld/mysqld.sock",
    "endpoints": [
      "/run/mysqld/mysqld.sock",
      "/var/run/mysqld/mysqld.sock",
      "/tmp/mysql.sock",
      "127.0.0.1",
      "::1"
    ],
    "port": 3306,
    "credentials": "my.cnf",
    "rights": "PROCESS for general activity and InnoDB; REPLICATION CLIENT (MySQL) or REPLICA MONITOR (MariaDB) for replication, the settings don’t change.",
    "metrics": [
      {
        "key": "connections",
        "label": "Connections",
        "unit": "count"
      },
      {
        "key": "connectionUsage",
        "label": "Employment of compounds",
        "unit": "percent",
        "rule": {
          "threshold": 90,
          "critical": 97,
          "mode": "value"
        }
      },
      {
        "key": "active",
        "label": "Active requests",
        "unit": "count"
      },
      {
        "key": "longQueries",
        "label": "Requests longer than 60s",
        "unit": "count",
        "rule": {
          "threshold": 1,
          "critical": null,
          "mode": "value"
        }
      },
      {
        "key": "longestQuery",
        "label": "Longest request",
        "unit": "seconds"
      },
      {
        "key": "blocked",
        "label": "Expecting InnoDB Transactions",
        "unit": "count"
      },
      {
        "key": "lockWait",
        "label": "Waiting for lockdown",
        "unit": "seconds",
        "rule": {
          "threshold": 30,
          "critical": null,
          "mode": "value"
        }
      },
      {
        "key": "longTransactions",
        "label": "Transactions longer than 5 minutes",
        "unit": "count",
        "rule": {
          "threshold": 1,
          "critical": null,
          "mode": "value"
        }
      },
      {
        "key": "slowQueries",
        "label": "Slow requests",
        "unit": "counter",
        "rule": {
          "threshold": 20,
          "critical": null,
          "mode": "delta_per_10m"
        }
      },
      {
        "key": "slowThreshold",
        "label": "The slow query threshold",
        "unit": "seconds"
      },
      {
        "key": "slowLog",
        "label": "Slow log enabled",
        "unit": "boolean"
      },
      {
        "key": "replicaSenders",
        "label": "Connected replicas",
        "unit": "count"
      },
      {
        "key": "missingPeers",
        "label": "Missing expected replicas",
        "unit": "count",
        "rule": {
          "threshold": 1,
          "critical": 1,
          "mode": "value"
        }
      },
      {
        "key": "channels",
        "label": "Replication channels",
        "unit": "count"
      },
      {
        "key": "replicationStopped",
        "label": "Shut down channels",
        "unit": "count",
        "rule": {
          "threshold": 1,
          "critical": 1,
          "mode": "value"
        }
      },
      {
        "key": "replicationErrors",
        "label": "Error channels",
        "unit": "count",
        "rule": {
          "threshold": 1,
          "critical": 1,
          "mode": "value"
        }
      },
      {
        "key": "replicationLag",
        "label": "Delayed replication",
        "unit": "seconds",
        "rule": {
          "threshold": 60,
          "critical": 300,
          "mode": "value"
        }
      },
      {
        "key": "replicationUnknown",
        "label": "Channels with unknown/determined delay",
        "unit": "count"
      },
      {
        "key": "bufferPoolUsed",
        "label": "Employment of buffer pool",
        "unit": "percent"
      },
      {
        "key": "bufferPoolDirty",
        "label": "Dirty pages of buffer pool",
        "unit": "percent"
      },
      {
        "key": "bufferPoolWaits",
        "label": "Expectations of a free page",
        "unit": "counter",
        "rule": {
          "threshold": 1,
          "critical": null,
          "mode": "delta_per_10m"
        }
      },
      {
        "key": "deadlocks",
        "label": "Deadlocks",
        "unit": "counter",
        "rule": {
          "threshold": 5,
          "critical": null,
          "mode": "delta_per_10m"
        }
      },
      {
        "key": "uptimeFlush",
        "label": "Seconds since the counters were reset",
        "unit": "seconds"
      }
    ],
    "actions": [
      "discover",
      "configure",
      "collect",
      "snapshot",
      "evaluate"
    ],
    "python": "mysql",
    "multiple": true,
    "replication": true,
    "units": [
      "mysql",
      "mariadb",
      "mysqld"
    ],
    "instanceCredentials": "cnf"
  },
